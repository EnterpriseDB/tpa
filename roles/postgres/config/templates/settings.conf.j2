{# YAML parses unquoted off/on/yes/no/true/false as booleans, so a value #}
{# like `bdr.default_streaming_mode: off` reaches us as the Python bool   #}
{# False. Rendering that verbatim writes `False`, which Postgres rejects  #}
{# for enum GUCs whose label is `off`/`on`. Emit on/off instead, which is #}
{# accepted both as those enum labels and as boolean GUC values.          #}
{% for k,v in postgres_conf_settings.items() %}
{{ k }} = {{ v|ternary('on', 'off') if v is boolean else v }}
{% endfor %}
