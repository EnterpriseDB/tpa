[Unit]
Description=Postgres startup monitor
After=postgres.service
Requires=postgres.service
{% if failover_manager == 'efm' and efm_autostart_db %}
After=edb-efm-{{ efm_version }}.service
{% endif %}

[Service]
Type=oneshot
User={{ postgres_user }}
Group={{ postgres_group }}
ExecStart=/etc/tpa/postgres-monitor "{{ postgres_dsn }}"
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
