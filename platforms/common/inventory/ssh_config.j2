Host *
    Port {{ ansible_port }}
{# Under Ansible Tower the SSH key is supplied by a Tower machine #}
{# credential, so we must not pin our own identity here: doing so #}
{# (especially with IdentitiesOnly) prevents Tower's key from being used. #}
{% if not ansible_tower %}
    IdentityFile "{{ ssh_key_file }}"
{% endif %}
    UserKnownHostsFile known_hosts tpa_known_hosts
    ServerAliveInterval 60
{% if not ansible_tower and not use_ssh_agent|default(False) %}
    IdentitiesOnly yes
{% endif %}
{% if forward_ssh_agent is defined %}
    ForwardAgent yes
{% endif %}

{% if jumphost is defined %}
# jumphost
Host {{ jumphost.name }}
    User {{ jumphost.user }}
    IdentityFile {{ jumphost.identity_file }}
{% endif %}

{% for h in instance_vars %}
Host {{ h.Name }} {{ h|deploy_ip_address }}
{% if 'ansible_user' in h.vars %}
    User {{ h.vars.ansible_user }}
{% endif %}
    HostName {{ h|deploy_ip_address }}
{% if jumphost is defined %}
    ProxyJump {{ jumphost.name }}
{% endif %}
{% endfor %}
